        "type": "object"
      },
      "SummaryResponse": {
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "handle": {
            "title": "Handle",
            "type": "string"
          },
          "has_more": {
            "title": "Has More",
