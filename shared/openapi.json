        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SolvedProblem": {
        "properties": {
          "contest_id": {
            "title": "Contest Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "problem_index": {
            "title": "Problem Index",
            "type": "string"
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "solved_at": {
            "format": "date-time",
            "title": "Solved At",
            "type": "string"
