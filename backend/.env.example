APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Use the Supabase Session pooler URI with the psycopg driver and sslmode=require.
# URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
AI_PROVIDER=gemini
# Select a supported model for your provider. Keys stay on the backend.
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
OPENAI_API_KEY=
